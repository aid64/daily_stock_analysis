# ── 换行符规范 ──────────────────────────────────────────────────────────
# 文本文件统一使用 LF 换行符 (跨平台兼容)
*       text=auto eol=lf

# 二进制文件不转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.sqlite binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.so    binary
*.pak   binary
*.asar  binary
*.bin   binary

# Shell 脚本
*.sh    text eol=lf

# Windows 批处理
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Python (PEP 8 推荐 LF)
*.py    text eol=lf diff=python

# Web 前端
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Markdown / 文档
*.md    text eol=lf
