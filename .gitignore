# ===================================
# daily_stock_analysis — .gitignore
# ===================================
#
# 敏感信息与本地文件保护，规范项目版本控制。
# 来源：合并上游官方 .gitignore + 本地自定义规则

# ── 环境变量（敏感信息）───────────────────────
.env
.env.*
*.env
*.env.local
.env.*.local

# ── 打包桌面应用 ─────────────────────────────
# 桌面端构建产物（用户运行时数据，已移到 apps/dsa-desktop/dist/installed/）
apps/dsa-desktop/dist/installed/

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── 虚拟环境 ─────────────────────────────────
venv/
ENV/
env/
.venv/

# ── IDE / 编辑器 ─────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.cursorrules
# Trae IDE 工作文档（PR smoke 日志、repack 脚本、PID 等）
.trae/
# electron-builder 下载的 winCodeSign 工具缓存（~116MB，本地构建产物）
.electron-builder-cache/

# ── 工具私有配置 ─────────────────────────────
.writerHelper/
.codex
.tmp
review.md
litellm_config.yaml
litellm_config.*.yaml

# ── 数据和日志 ───────────────────────────────
data/
.llm_usage_hmac_secret
**/.llm_usage_hmac_secret
logs/
reports/
*.db
*.sqlite
*.sqlite3

# ── 系统文件 ─────────────────────────────────
.DS_Store
Thumbs.db

# ── 测试 ─────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── 本地临时文件 ─────────────────────────────
local/
run.sh
# 仅忽略根目录的 verify_*.py / test_*.py 临时脚本，不影响 tests/ 目录下的正式测试
/verify_*.py
/test_*.py
test.sh

# ── Claude 工作区 ────────────────────────────
.claude/*
!.claude/skills/
!.claude/skills/**

# ── 前端构建产物 ─────────────────────────────
static/
apps/dsa-desktop/dist/
apps/dsa-desktop/node_modules/
# PR2：build-backend.ps1 把 static/ 同步到 renderer/web/，供 Electron 打包后 file:// 加载
apps/dsa-desktop/renderer/web/

# ── 文档规范 ─────────────────────────────────
docs/specs/

# ── WorkBuddy AI 辅助文件 ────────────────────
.workbuddy/
