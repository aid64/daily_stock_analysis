# ===================================
# quant_research — 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================

# ── 数据源 ───────────────────────────────────
# Tushare Pro Token（从 https://tushare.pro 注册获取，15000 积分权限可访问日线/财务/可转债）
TUSHARE_TOKEN=

# 同花顺 iFinD 密钥（可选，仅 build_pit_snapshot.py 构建可转债 PIT 历史快照时使用）
# 通过环境变量 IFIND_AUTH_TOKEN 注入；未配置时 iFinD 客户端启动即报错，但不影响其他数据源
IFIND_AUTH_TOKEN=

# 主项目 bot API（可选，用于复用主项目通知通道推送策略信号）
# 留空则禁用通知，仅本地落库 + 日志
DSA_BOT_API=http://localhost:8000

# ── 路径覆盖（可选）──────────────────────────
# 数据缓存根目录，默认相对路径 data/cache
# QR_CACHE_DIR=

# 原始下载目录，默认 data/raw
# QR_RAW_DIR=

# ── 实盘执行（P4，可选）──────────────────────
# tdxjk 通达信交易接口（TJyaid.dll）。用法见 docs 架构文档 6.2.3：
# 1) 下载试用包，将 TJyaid.dll 放到 data/trade/ 下（32 位 DLL）
# 2) 填写以下券商连接参数（服务器 IP/端口可从 tdxw.exe 演示版获知）
# 3) run_live.py --mode tdxjk 启动实盘
# 注意：DLL 为 32 位，需 32 位 Python；密码仅在内存中传递不落盘
TDXJK_QS=
TDXJK_IP=
TDXJK_PORT=
TDXJK_YYBID=
TDXJK_LOGIN_MODE=9
TDXJK_ACCOUNT=
TDXJK_TRADE_ACCOUNT=
TDXJK_PASSWORD=

# ── 日志 ─────────────────────────────────────
# 日志级别 DEBUG / INFO / WARNING / ERROR
QR_LOG_LEVEL=INFO
